rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // صور طلبات الإضافة المعلّقة: يرفعها أي زائر (بحجم وصيغة محدودة)
    match /pending_photos/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // صور الأفراد المعتمدين في الشجرة: لا يرفعها إلا الأدمن
    match /member_photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
